# CAREFlow Application Configuration Template

# Server Settings
PROJECT_NAME="CAREFlow India"
PROJECT_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# API & CORS
API_V1_STR="/api"
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Database Settings
# Default for local lightweight development: SQLite
DATABASE_URL="sqlite:///./careflow_dev.db"

# Production PostgreSQL Configuration Example:
# DATABASE_URL="postgresql://careflow_user:secure_password@localhost:5432/careflow_db"
