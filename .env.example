# CAREFlow Application Environment Configuration Template
# Copy this file to '.env' for local configuration. Never commit real production credentials to Git.

# Environment & Server Settings
PROJECT_NAME="CAREFlow India"
PROJECT_VERSION="0.1.0"
ENVIRONMENT="development" # Options: development, testing, production
DEBUG=true
LOG_LEVEL="INFO" # Options: DEBUG, INFO, WARNING, ERROR

# Security Credentials
# IMPORTANT: In 'production', SECRET_KEY MUST be a unique, random key at least 32 characters long.
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="dev_secret_key_change_in_production_1234567890"

# API & Cross-Origin Resource Sharing (CORS)
API_V1_STR="/api"
API_BASE_URL="/api"
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Database Configuration
# Local Development / Testing (Default: SQLite)
DATABASE_URL="sqlite:///./careflow_dev.db"

# Production PostgreSQL Configuration Example:
# DATABASE_URL="postgresql://careflow_user:YOUR_POSTGRES_PASSWORD_HERE@localhost:5432/careflow_prod_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
